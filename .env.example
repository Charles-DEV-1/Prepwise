NEXT_PUBLIC_APP_URL=https://www.prepcore.com.ng
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
# Keep this secret server-side. Never prefix it with NEXT_PUBLIC_.
# Optional: defaults to openai/gpt-oss-20b, Groq's replacement for llama-3.1-8b-instant.
GROQ_MODEL=openai/gpt-oss-20b
# Server-only ALOC Station key. Never prefix with NEXT_PUBLIC_.
ALOC_API_KEY=
# Legacy ALOC endpoint token fallback. Prefer ALOC_API_KEY for new keys.
ALOC_ACCESS_TOKEN=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Legacy Flutterwave webhook hash header fallback, if your dashboard uses verif-hash
FLUTTERWAVE_SECRET_HASH=
# Comma-separated admin emails allowed to access /admin and partner APIs
ADMIN_EMAILS=
